{
    "name": "luminix/sheets",
    "description": "Import and export spreadsheets for Luminix models",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arandu Tech",
            "email": "desenvolvedor@arandutech.com.br"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0",
        "luminix/backend": "*",
        "phpoffice/phpspreadsheet": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Luminix\\Sheets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luminix\\Sheets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Luminix\\Sheets\\LuminixSheetsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}